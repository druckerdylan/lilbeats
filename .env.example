# The canonical URL of your deployed site (used in metadata, emails, Stripe redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project URL from the Connect dialog; keys from Settings > API Keys.
# Supabase renamed these: publishable (sb_publishable_...) was anon, and
# secret (sb_secret_...) was service_role. Either naming works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into /admin. REQUIRED — the Supabase anon key is
# public and sign-up is enabled by default, so without this anyone who registers
# could reach the dashboard (customer emails, phone numbers, order history).
# Also disable public sign-ups in Supabase → Authentication → Providers.
ADMIN_EMAILS=

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=
# Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=

# Resend — resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sending domain/address in your Resend account.
RESEND_FROM_EMAIL="Lil Beats <orders@lilbeats.com>"
