# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local beat staging (large audio, not for the repo)
/.beats-staging

# Local Stripe CLI binary (35MB, not source)
/bin/stripe

# Local catalogue backup: gigabytes of masters, WAVs and stems pulled out of
# Supabase by `pnpm backup-catalog`. This repo is public — these must never
# be committed. They are the backup, not the source of truth.
/catalog-backup
